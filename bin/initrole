#!/bin/bash

mkdir -p "./roles/$1"

(
  cd "./roles/$1"
  mkdir defaults
  mkdir tasks
  mkdir vars

  touch defaults/main.yml
  touch tasks/main.yml
  touch vars/linux.yml

  cat << EOF > "tasks/main.yml"
---

- name: "{{ ansible_system }} vars"
  include_vars: "{{ ansible_system|lower }}.yml"

# source distribution-specific tasks (e.g. debian)
# - name: "{{ ansible_os_family }} tasks"
#   include_tasks: "{{ ansible_os_family|lower }}.yml"
EOF

)